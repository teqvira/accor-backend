    {
      "name": "13. Payout Webhooks (Bulkpe, Cashfree, Razorpay)",
      "description": "Endpoints to test incoming webhook callbacks from payout providers. Use these to test marking pending withdrawals as SUCCESS (with bank UTR) or FAILED (which automatically triggers wallet refunds).",
      "item": [
        {
          "name": "Bulkpe Webhook - Payout SUCCESS (with UTR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": true,\n  \"statusCode\": 200,\n  \"data\": {\n    \"transaction_id\": \"TRAREF00034637453\",\n    \"reference_id\": \"{{withdrawalReferenceId}}\",\n    \"amount\": 100,\n    \"payment_mode\": \"IMPS\",\n    \"status\": \"SUCCESS\",\n    \"utr\": \"UTR123456789012\",\n    \"message\": \"Transaction Successful\"\n  },\n  \"message\": \"Webhook processed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/bulkpe/payout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "bulkpe",
                "payout"
              ]
            }
          }
        },
