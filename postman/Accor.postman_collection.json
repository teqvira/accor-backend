        {
          "name": "Withdrawal Step 2: Verify OTP & Submit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set(\"withdrawalId\", res.data.id);",
                  "}",
                  "if (res.data && res.data.transactionReference) {",
                  "    pm.collectionVariables.set(\"withdrawalReferenceId\", res.data.transactionReference);",
                  "} else if (res.data && res.data.providerReferenceId) {",
                  "    pm.collectionVariables.set(\"withdrawalReferenceId\", res.data.providerReferenceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/withdraw/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "withdraw",
                "verify-otp"
              ]
            }
          }
        },
